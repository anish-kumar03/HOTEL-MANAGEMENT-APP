<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/alerts') %>

  <!-- Header & Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Customer Management</h2>
      <p class="text-muted mb-0">View, search, create, update, and manage hotel customer records.</p>
    </div>
    <div>
      <a href="/customers/new" class="btn btn-primary px-3 py-2 shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i>Add Customer
      </a>
    </div>
  </div>

  <!-- Search Bar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/customers" method="GET" class="row g-2 align-items-center">
        <div class="col-md-9 col-lg-10">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input 
              type="text" 
              name="search" 
              class="form-control border-start-0 bg-light" 
              placeholder="Search customers by name, email, or phone number..." 
              value="<%= typeof search !== 'undefined' ? search : '' %>"
            >
          </div>
        </div>
        <div class="col-md-3 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-dark w-100">
            <i class="bi bi-funnel-fill me-1"></i>Search
          </button>
          <% if (typeof search !== 'undefined' && search) { %>
            <a href="/customers" class="btn btn-outline-secondary" title="Clear Search">
              <i class="bi bi-x-circle"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Customers Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0 fw-semibold">
        Customer Directory 
        <span class="badge bg-secondary-subtle text-secondary ms-2"><%= customers.length %> record(s)</span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (customers.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-person-slash display-4 text-muted mb-3 d-block"></i>
          <h5 class="fw-semibold text-secondary">No customers found</h5>
          <p class="text-muted small">
            <% if (typeof search !== 'undefined' && search) { %>
              No customers matched your search query "<%= search %>".
            <% } else { %>
              There are currently no customer records in the database.
            <% } %>
          </p>
          <a href="/customers/new" class="btn btn-sm btn-primary mt-2">
            <i class="bi bi-plus-circle me-1"></i>Add First Customer
          </a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-4">ID</th>
                <th scope="col">Full Name</th>
                <th scope="col">Email</th>
                <th scope="col">Phone</th>
                <th scope="col">Address</th>
                <th scope="col">Registration Date</th>
                <th scope="col" class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% customers.forEach(customer => { %>
                <tr>
                  <td class="ps-4 fw-semibold text-secondary">#<%= customer.id %></td>
                  <td>
                    <a href="/customers/<%= customer.id %>" class="fw-bold text-dark text-decoration-none hover-primary">
                      <%= customer.name %>
                    </a>
                  </td>
                  <td>
                    <a href="mailto:<%= customer.email %>" class="text-muted text-decoration-none small">
                      <i class="bi bi-envelope me-1"></i><%= customer.email %>
                    </a>
                  </td>
                  <td>
                    <span class="text-muted small">
                      <i class="bi bi-telephone me-1"></i><%= customer.phone %>
                    </span>
                  </td>
                  <td>
                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 220px;" title="<%= customer.address || 'N/A' %>">
                      <%= customer.address || '<em class="text-muted">None specified</em>' %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-light text-secondary border small">
                      <i class="bi bi-calendar3 me-1"></i><%= customer.registration_date %>
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                      <a href="/customers/<%= customer.id %>" class="btn btn-outline-primary" title="View Details">
                        <i class="bi bi-eye"></i>
                      </a>
                      <a href="/customers/<%= customer.id %>/edit" class="btn btn-outline-secondary" title="Edit Customer">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <button 
                        type="button" 
                        class="btn btn-outline-danger" 
                        title="Delete Customer"
                        data-bs-toggle="modal" 
                        data-bs-target="#deleteModal<%= customer.id %>"
                      >
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>

                    <!-- Delete Confirmation Modal -->
                    <div class="modal fade text-start" id="deleteModal<%= customer.id %>" tabindex="-1" aria-labelledby="modalLabel<%= customer.id %>" aria-hidden="true">
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                          <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="modalLabel<%= customer.id %>">
                              <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body p-4">
                            <p class="mb-2">Are you sure you want to delete customer <strong>"<%= customer.name %>" (ID: #<%= customer.id %>)</strong>?</p>
                            <div class="alert alert-warning small mb-0">
                              <i class="bi bi-info-circle me-1"></i> Note: Deletion will be rejected if this customer has any existing reservation records.
                            </div>
                          </div>
                          <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form action="/customers/<%= customer.id %>/delete" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Delete Permanently
                              </button>
                            </form>
                          </div>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
