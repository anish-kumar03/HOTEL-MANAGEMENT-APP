<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/alerts') %>

  <!-- Header & Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-door-open-fill text-primary me-2"></i>Room Management</h2>
      <p class="text-muted mb-0">View, search, filter, add, update, and manage hotel room inventory.</p>
    </div>
    <div>
      <a href="/rooms/new" class="btn btn-primary px-3 py-2 shadow-sm">
        <i class="bi bi-plus-circle me-2"></i>Add Room
      </a>
    </div>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/rooms" method="GET" class="row g-2 align-items-center">
        <!-- Search by Room Number -->
        <div class="col-md-4">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input 
              type="text" 
              name="search" 
              class="form-control border-start-0 bg-light" 
              placeholder="Search by room number..." 
              value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
            >
          </div>
        </div>

        <!-- Filter by Category -->
        <div class="col-md-3">
          <select name="category" class="form-select bg-light">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= typeof filters !== 'undefined' && filters.category === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Filter by Status -->
        <div class="col-md-3">
          <select name="status" class="form-select bg-light">
            <option value="">All Statuses</option>
            <% statuses.forEach(st => { %>
              <option value="<%= st %>" <%= typeof filters !== 'undefined' && filters.status === st ? 'selected' : '' %>>
                <%= st %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Submit & Reset -->
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-dark w-100">
            <i class="bi bi-funnel-fill me-1"></i>Filter
          </button>
          <% if (typeof filters !== 'undefined' && (filters.search || filters.category || filters.status)) { %>
            <a href="/rooms" class="btn btn-outline-secondary" title="Reset Filters">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- View Toggle Header & Rooms Container -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="d-flex align-items-center gap-2">
        <h5 class="card-title mb-0 fw-bold">Room Inventory</h5>
        <span class="badge bg-secondary-subtle text-secondary ms-2"><%= rooms.length %> room(s)</span>
      </div>
      
      <!-- Nav Tabs for Cards vs Table -->
      <ul class="nav nav-pills card-header-pills" id="roomViewTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active btn-sm px-3" id="cards-tab" data-bs-toggle="tab" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="true">
            <i class="bi bi-grid-fill me-1"></i>Room Cards
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link btn-sm px-3" id="table-tab" data-bs-toggle="tab" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="false">
            <i class="bi bi-list-ul me-1"></i>Table View
          </button>
        </li>
      </ul>
    </div>

    <div class="card-body p-4">
      <% if (rooms.length === 0) { %>
        <div class="empty-state-box">
          <div class="empty-state-icon">
            <i class="bi bi-door-closed"></i>
          </div>
          <h5 class="fw-bold text-dark">No rooms found</h5>
          <p class="text-muted small mb-3">
            <% if (typeof filters !== 'undefined' && (filters.search || filters.category || filters.status)) { %>
              No physical rooms matched your active filter criteria.
            <% } else { %>
              There are currently no room records registered in the database.
            <% } %>
          </p>
          <a href="/rooms/new" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>Add New Room
          </a>
        </div>
      <% } else { %>
        <div class="tab-content" id="roomViewTabContent">
          <!-- VIEW 1: ROOM CARDS GRID -->
          <div class="tab-pane fade show active" id="cards-view" role="tabpanel" aria-labelledby="cards-tab">
            <div class="row g-3">
              <% rooms.forEach(room => { %>
                <div class="col-sm-6 col-md-4 col-xl-3">
                  <div class="room-grid-card h-100">
                    <div class="room-grid-header border-bottom">
                      <div>
                        <div class="text-muted small fw-semibold text-uppercase">Room</div>
                        <div class="room-number-pill">
                          <i class="bi bi-door-open text-primary me-1"></i><%= room.room_number %>
                        </div>
                      </div>
                      <div>
                        <% if (room.status === 'ACTIVE') { %>
                          <span class="badge badge-status-active">
                            <i class="bi bi-check-circle-fill me-1"></i>ACTIVE
                          </span>
                        <% } else { %>
                          <span class="badge badge-status-maintenance">
                            <i class="bi bi-tools me-1"></i>MAINTENANCE
                          </span>
                        <% } %>
                      </div>
                    </div>
                    <div class="p-3">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Category:</span>
                        <% if (room.category === 'Suite') { %>
                          <span class="badge bg-dark"><i class="bi bi-stars text-warning me-1"></i>Suite</span>
                        <% } else if (room.category === 'Premium') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Premium</span>
                        <% } else if (room.category === 'Deluxe') { %>
                          <span class="badge bg-info-subtle text-info border border-info-subtle">Deluxe</span>
                        <% } else { %>
                          <span class="badge bg-light text-secondary border">Standard</span>
                        <% } %>
                      </div>
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Capacity:</span>
                        <span class="small fw-semibold text-dark">
                          <i class="bi bi-person me-1"></i><%= room.capacity %> <%= room.capacity === 1 ? 'Guest' : 'Guests' %>
                        </span>
                      </div>
                      <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted small">Tariff:</span>
                        <div>
                          <span class="room-tariff">₹<%= Number(room.price_per_night).toFixed(0) %></span>
                          <small class="text-muted">/nt</small>
                        </div>
                      </div>
                    </div>
                    <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                      <a href="/reservations/new?room_id=<%= room.id %>" class="btn btn-sm btn-outline-primary py-1 px-2">
                        <i class="bi bi-calendar-plus me-1"></i>Book
                      </a>
                      <div class="btn-group btn-group-sm">
                        <a href="/rooms/<%= room.id %>/edit" class="btn btn-outline-secondary py-1" title="Edit">
                          <i class="bi bi-pencil"></i>
                        </a>
                        <button type="button" class="btn btn-outline-danger py-1" data-bs-toggle="modal" data-bs-target="#deleteRoomModal<%= room.id %>" title="Delete">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- VIEW 2: STRUCTURED TABLE VIEW -->
          <div class="tab-pane fade" id="table-view" role="tabpanel" aria-labelledby="table-tab">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="ps-3">Room #</th>
                    <th scope="col">Category</th>
                    <th scope="col">Capacity</th>
                    <th scope="col">Nightly Rate</th>
                    <th scope="col">Operational Status</th>
                    <th scope="col" class="text-end pe-3">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% rooms.forEach(room => { %>
                    <tr>
                      <td class="ps-3">
                        <span class="fw-bold text-dark fs-6">
                          <i class="bi bi-door-closed text-primary me-1"></i>Room <%= room.room_number %>
                        </span>
                      </td>
                      <td>
                        <% if (room.category === 'Suite') { %>
                          <span class="badge bg-dark"><i class="bi bi-stars text-warning me-1"></i>Suite</span>
                        <% } else if (room.category === 'Premium') { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Premium</span>
                        <% } else if (room.category === 'Deluxe') { %>
                          <span class="badge bg-info-subtle text-info border border-info-subtle">Deluxe</span>
                        <% } else { %>
                          <span class="badge bg-light text-secondary border">Standard</span>
                        <% } %>
                      </td>
                      <td><%= room.capacity %> <%= room.capacity === 1 ? 'Guest' : 'Guests' %></td>
                      <td class="fw-bold text-dark">₹<%= Number(room.price_per_night).toFixed(2) %></td>
                      <td>
                        <% if (room.status === 'ACTIVE') { %>
                          <span class="badge badge-status-active">ACTIVE</span>
                        <% } else { %>
                          <span class="badge badge-status-maintenance">MAINTENANCE</span>
                        <% } %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                          <a href="/reservations/new?room_id=<%= room.id %>" class="btn btn-outline-primary" title="Book Room">
                            <i class="bi bi-calendar-plus"></i>
                          </a>
                          <a href="/rooms/<%= room.id %>/edit" class="btn btn-outline-secondary" title="Edit Room">
                            <i class="bi bi-pencil"></i>
                          </a>
                          <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteRoomModal<%= room.id %>" title="Delete Room">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Modals for deletion -->
        <% rooms.forEach(room => { %>
          <div class="modal fade text-start" id="deleteRoomModal<%= room.id %>" tabindex="-1" aria-labelledby="roomModalLabel<%= room.id %>" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                  <h5 class="modal-title" id="roomModalLabel<%= room.id %>">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Room Deletion
                  </h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                  <p class="mb-2">Are you sure you want to delete <strong>Room "<%= room.room_number %>" (<%= room.category %>)</strong>?</p>
                  <div class="alert alert-warning small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Note: Deletion will be rejected if this room has any historical or upcoming reservations.
                  </div>
                </div>
                <div class="modal-footer bg-light">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                  <form action="/rooms/<%= room.id %>/delete" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                      <i class="bi bi-trash me-1"></i>Delete Room
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

