<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
          <li class="breadcrumb-item"><a href="/rooms">Rooms</a></li>
          <li class="breadcrumb-item active" aria-current="page">Edit Room <%= room.room_number %></li>
        </ol>
      </nav>

      <%- include('../partials/alerts') %>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h4 class="card-title mb-0 fw-bold">
            <i class="bi bi-pencil-square text-primary me-2"></i>Edit Room #<%= room.id %> (<%= room.room_number %>)
          </h4>
          <span class="badge <%= room.status === 'ACTIVE' ? 'bg-success' : 'bg-danger' %>">
            <%= room.status %>
          </span>
        </div>
        <div class="card-body p-4">
          <form action="/rooms/<%= room.id %>/edit" method="POST" novalidate>
            <!-- Room Number & Category -->
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label for="room_number" class="form-label fw-semibold">
                  Room Number <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-hash"></i></span>
                  <input 
                    type="text" 
                    class="form-control" 
                    id="room_number" 
                    name="room_number" 
                    value="<%= typeof formData !== 'undefined' && formData.room_number ? formData.room_number : room.room_number %>"
                    required
                  >
                </div>
              </div>

              <div class="col-md-6">
                <label for="category" class="form-label fw-semibold">
                  Room Category <span class="text-danger">*</span>
                </label>
                <select class="form-select" id="category" name="category" required>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat %>" <%= (typeof formData !== 'undefined' && formData.category === cat) || room.category === cat ? 'selected' : '' %>>
                      <%= cat %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>

            <!-- Capacity, Price & Status -->
            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label for="capacity" class="form-label fw-semibold">
                  Capacity (Guests) <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-people"></i></span>
                  <input 
                    type="number" 
                    class="form-control" 
                    id="capacity" 
                    name="capacity" 
                    min="1" 
                    max="10"
                    value="<%= typeof formData !== 'undefined' && formData.capacity ? formData.capacity : room.capacity %>"
                    required
                  >
                </div>
              </div>

              <div class="col-md-4">
                <label for="price_per_night" class="form-label fw-semibold">
                  Price / Night (₹) <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text">₹</span>
                  <input 
                    type="number" 
                    step="0.01" 
                    min="0"
                    class="form-control" 
                    id="price_per_night" 
                    name="price_per_night" 
                    value="<%= typeof formData !== 'undefined' && formData.price_per_night ? formData.price_per_night : room.price_per_night %>"
                    required
                  >
                </div>
              </div>

              <div class="col-md-4">
                <label for="status" class="form-label fw-semibold">
                  Operational Status <span class="text-danger">*</span>
                </label>
                <select class="form-select" id="status" name="status" required>
                  <% statuses.forEach(st => { %>
                    <option value="<%= st %>" <%= (typeof formData !== 'undefined' && formData.status === st) || room.status === st ? 'selected' : '' %>>
                      <%= st %>
                    </option>
                  <% }); %>
                </select>
              </div>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3">
              <a href="/rooms" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-circle me-1"></i>Cancel
              </a>
              <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check2-circle me-1"></i>Update Room
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
