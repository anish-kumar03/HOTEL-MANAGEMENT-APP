<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <%- include('../partials/alerts') %>

  <% if (typeof dbNotice !== 'undefined' && dbNotice) { %>
    <div class="alert alert-warning border-0 shadow-sm alert-dismissible fade show" role="alert">
      <div class="d-flex align-items-center">
        <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
        <div><strong>Database Notice:</strong> <%= dbNotice %></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Dashboard Header & Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-2 rounded-pill bg-success-subtle text-success border border-success-subtle small fw-semibold">
        <i class="bi bi-check-circle-fill"></i> Phase 7 Dynamic Admin Engine Active
      </div>
      <h2 class="fw-bold mb-1 text-dark">
        <i class="bi bi-speedometer2 text-primary me-2"></i>Hotel Operations Executive Dashboard
      </h2>
      <p class="text-muted mb-0">
        Real-time telemetry, occupancy rates, financial metrics, and Chart.js analytics powered directly by MySQL.
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/reports" class="btn btn-outline-dark px-3 py-2 shadow-sm">
        <i class="bi bi-file-earmark-bar-graph me-1"></i>View All Reports
      </a>
      <a href="/reservations/new" class="btn btn-primary px-3 py-2 shadow-sm">
        <i class="bi bi-plus-circle me-1"></i>New Booking
      </a>
      <a href="/payments/new" class="btn btn-outline-success px-3 py-2 shadow-sm">
        <i class="bi bi-cash-stack me-1"></i>Record Payment
      </a>
      <button onclick="window.location.reload()" class="btn btn-light border px-3 py-2" title="Refresh Live Data">
        <i class="bi bi-arrow-clockwise"></i>
      </button>
    </div>
  </div>

  <!-- SECTION 1: THE 6 CORE EXECUTIVE STATISTIC CARDS -->
  <div class="row g-3 mb-4">
    <!-- 1. Total Rooms -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">1. Total Rooms</span>
          <div class="stat-widget-icon primary"><i class="bi bi-door-closed"></i></div>
        </div>
        <div class="stat-widget-value"><%= stats.totalRooms %></div>
        <div class="stat-widget-footer">
          <span class="badge bg-light text-secondary border">Physical Inventory</span>
        </div>
      </div>
    </div>

    <!-- 2. Available Rooms -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">4. Available Today</span>
          <div class="stat-widget-icon success"><i class="bi bi-calendar-check"></i></div>
        </div>
        <div class="stat-widget-value text-success"><%= stats.availableRoomsToday %></div>
        <div class="stat-widget-footer">
          <span class="badge bg-success-subtle text-success border border-success-subtle">Ready to Book</span>
        </div>
      </div>
    </div>

    <!-- 3. Occupied Rooms -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">3. Occupied</span>
          <div class="stat-widget-icon danger"><i class="bi bi-person-check"></i></div>
        </div>
        <div class="stat-widget-value text-danger"><%= stats.currentlyOccupiedRooms %></div>
        <div class="stat-widget-footer">
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Guests Checked In</span>
        </div>
      </div>
    </div>

    <!-- 4. Total Customers -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">5. Customers</span>
          <div class="stat-widget-icon info"><i class="bi bi-people"></i></div>
        </div>
        <div class="stat-widget-value text-dark"><%= stats.totalRegisteredCustomers %></div>
        <div class="stat-widget-footer">
          <span class="badge bg-light text-secondary border">Registered Guests</span>
        </div>
      </div>
    </div>

    <!-- 5. Reservations -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">6. Bookings</span>
          <div class="stat-widget-icon purple"><i class="bi bi-journal-bookmark"></i></div>
        </div>
        <div class="stat-widget-value text-dark"><%= stats.totalReservations %></div>
        <div class="stat-widget-footer">
          <span class="badge bg-light text-secondary border">All-Time Bookings</span>
        </div>
      </div>
    </div>

    <!-- 6. Monthly Revenue -->
    <div class="col-sm-6 col-lg-4 col-xl-2">
      <div class="stat-widget h-100">
        <div class="stat-widget-header">
          <span class="stat-widget-title">9. Monthly Revenue</span>
          <div class="stat-widget-icon success"><i class="bi bi-currency-rupee"></i></div>
        </div>
        <div class="stat-widget-value text-success" style="font-size: 1.5rem;">
          ₹<%= Number(stats.monthlyRevenue).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %>
        </div>
        <div class="stat-widget-footer">
          <span class="badge bg-success-subtle text-success border border-success-subtle">Current Month</span>
        </div>
      </div>
    </div>
  </div>

  <!-- SECONDARY OPERATIONAL METRICS STRIP -->
  <div class="row g-3 mb-4">
    <!-- Active Rooms -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm bg-white p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">2. Active Rooms</div>
            <h4 class="fw-bold text-dark mb-0 mt-1"><%= stats.activeRooms %> / <%= stats.totalRooms %></h4>
          </div>
          <span class="p-2 bg-light text-primary rounded-3"><i class="bi bi-door-open fs-5"></i></span>
        </div>
      </div>
    </div>

    <!-- Today's Check-Ins -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm bg-white p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">7. Today's Check-Ins</div>
            <h4 class="fw-bold text-success mb-0 mt-1"><%= stats.todayCheckIns %></h4>
          </div>
          <span class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-box-arrow-in-right fs-5"></i></span>
        </div>
      </div>
    </div>

    <!-- Today's Check-Outs -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm bg-white p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold text-uppercase">8. Today's Check-Outs</div>
            <h4 class="fw-bold text-warning text-dark mb-0 mt-1"><%= stats.todayCheckOuts %></h4>
          </div>
          <span class="p-2 bg-warning-subtle text-warning rounded-3"><i class="bi bi-box-arrow-right fs-5"></i></span>
        </div>
      </div>
    </div>

    <!-- Pending Payment Amount -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm bg-white p-3">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-muted small fw-semibold text-uppercase text-danger">10. Pending Balance</div>
            <h4 class="fw-bold text-danger mb-0 mt-1">₹<%= Number(stats.pendingPaymentAmount).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) %></h4>
          </div>
          <span class="p-2 bg-danger-subtle text-danger rounded-3"><i class="bi bi-hourglass-split fs-5"></i></span>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2: CHART.JS VISUALIZATIONS -->
  <div class="row g-4 mb-4">
    <!-- Chart 1: Monthly Revenue Trend -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm h-100 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-graph-up text-primary me-2"></i>Monthly Revenue Trend (Last 6 Months)
          </h5>
          <span class="badge bg-light text-secondary border">Real MySQL Payments</span>
        </div>
        <div class="card-body p-4">
          <div style="position: relative; height: 300px; width: 100%;">
            <canvas id="monthlyRevenueChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Chart 2: Room Category Distribution -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-pie-chart text-success me-2"></i>Room Categories
          </h5>
          <span class="badge bg-light text-secondary border">Inventory Breakdown</span>
        </div>
        <div class="card-body p-4 d-flex align-items-center justify-content-center">
          <div style="position: relative; height: 260px; width: 100%;">
            <canvas id="roomCategoryChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chart 3: Monthly Reservations Volume & Status Breakdown -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-bar-chart-steps text-info me-2"></i>Monthly Reservation Volume & Lifecycle Distribution
          </h5>
          <span class="badge bg-light text-secondary border">Confirmed vs Checked In vs Checked Out vs Cancelled</span>
        </div>
        <div class="card-body p-4">
          <div style="position: relative; height: 280px; width: 100%;">
            <canvas id="monthlyReservationsChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3: RECENT ACTIVITIES TABLES & QUICK REPORTS -->
  <div class="row g-4 mb-4">
    <!-- Recent Reservations -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm h-100 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-journal-check text-primary me-2"></i>Recent Booking Activities
          </h5>
          <a href="/reservations" class="btn btn-sm btn-outline-dark">View All Bookings</a>
        </div>
        <div class="card-body p-0">
          <% if (activities.recentReservations.length === 0) { %>
            <div class="text-center py-4 text-muted">No reservations recorded yet.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3">Booking Code</th>
                    <th>Customer</th>
                    <th>Room</th>
                    <th>Stay Dates</th>
                    <th>Amount</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% activities.recentReservations.forEach(r => { %>
                    <tr>
                      <td class="ps-3 font-monospace fw-semibold">
                        <a href="/reservations/<%= r.id %>" class="text-decoration-none"><%= r.booking_code %></a>
                      </td>
                      <td><%= r.customer_name %></td>
                      <td>Room <%= r.room_number %> <small class="text-muted">(<%= r.room_category %>)</small></td>
                      <td class="small"><%= r.check_in_date %> &rarr; <%= r.check_out_date %></td>
                      <td class="fw-bold">₹<%= Number(r.total_amount).toFixed(2) %></td>
                      <td>
                        <% if (r.status === 'confirmed') { %>
                          <span class="badge bg-success">Confirmed</span>
                        <% } else if (r.status === 'checked_in') { %>
                          <span class="badge bg-primary">Checked In</span>
                        <% } else if (r.status === 'checked_out') { %>
                          <span class="badge bg-secondary">Checked Out</span>
                        <% } else if (r.status === 'cancelled') { %>
                          <span class="badge bg-danger">Cancelled</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark"><%= r.status %></span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Recent Payments -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm h-100 bg-white">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-credit-card-2-front text-success me-2"></i>Recent Payment Settlements
          </h5>
          <a href="/payments" class="btn btn-sm btn-outline-dark">View Ledger</a>
        </div>
        <div class="card-body p-0">
          <% if (activities.recentPayments.length === 0) { %>
            <div class="text-center py-4 text-muted">No payment settlements recorded yet.</div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3">Receipt</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th class="pe-3">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% activities.recentPayments.forEach(p => { %>
                    <tr>
                      <td class="ps-3 font-monospace small">
                        <a href="/payments/<%= p.id %>/receipt" class="text-decoration-none"><%= p.payment_reference %></a>
                      </td>
                      <td class="small"><%= p.customer_name %></td>
                      <td class="fw-bold text-success">₹<%= Number(p.amount).toFixed(2) %></td>
                      <td><span class="badge bg-light text-dark border"><%= p.payment_method %></span></td>
                      <td class="pe-3">
                        <span class="badge <%= p.payment_status === 'SUCCESS' ? 'bg-success' : 'bg-warning text-dark' %>">
                          <%= p.payment_status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4: QUICK ACCESS TO THE 7 REPORTS -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0 fw-bold">
        <i class="bi bi-file-earmark-bar-graph text-dark me-2"></i>Executive Reporting Suite
      </h5>
      <span class="badge bg-primary">7 Modular Reports Available</span>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-6 col-lg-3">
          <a href="/reports/daily-reservations" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-calendar2-day text-info me-2"></i>1. Daily Reservations</div>
              <p class="small text-muted mb-0">Itemized bookings, daily guest arrival, check-ins and revenue.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/monthly-reservations" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-calendar2-month text-primary me-2"></i>2. Monthly Reservations</div>
              <p class="small text-muted mb-0">Booking volumes, average stay lengths, and cancellation rates.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/customer-bookings" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-success me-2"></i>3. Customer Bookings</div>
              <p class="small text-muted mb-0">Guest frequency, lifetime spend, and repeat guest analysis.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/room-availability" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-calendar-check text-warning me-2"></i>4. Room Availability</div>
              <p class="small text-muted mb-0">Physical room occupancy, target date availability, and rates.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/monthly-revenue" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-success me-2"></i>5. Monthly Revenue</div>
              <p class="small text-muted mb-0">Gross collections broken down by Cash, UPI, and Card.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/payment-history" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-credit-card-2-back text-info me-2"></i>6. Payment History</div>
              <p class="small text-muted mb-0">Comprehensive settlement logs with multi-parameter filters.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports/cancelled-reservations" class="text-decoration-none text-dark">
            <div class="p-3 bg-light rounded-3 border h-100 report-quick-card">
              <div class="fw-bold mb-1"><i class="bi bi-x-circle text-danger me-2"></i>7. Cancelled Bookings</div>
              <p class="small text-muted mb-0">Lost revenue audit and recorded cancellation reasons.</p>
            </div>
          </a>
        </div>
        <div class="col-md-6 col-lg-3">
          <a href="/reports" class="text-decoration-none text-dark">
            <div class="p-3 bg-primary-subtle text-primary rounded-3 border border-primary-subtle h-100 report-quick-card d-flex align-items-center justify-content-center text-center">
              <div>
                <i class="bi bi-grid-fill fs-3 mb-1 d-block"></i>
                <strong>Open Reports Catalog &rarr;</strong>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Chart.js Live Initialization Script -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Safe extraction of server-side data from MySQL
  const revenueData = <%- JSON.stringify(charts.monthlyRevenueChart) %>;
  const categoryData = <%- JSON.stringify(charts.roomCategoryChart) %>;
  const reservationsData = <%- JSON.stringify(charts.monthlyReservationsChart) %>;

  // 1. Chart 1: Monthly Revenue (Bar Chart)
  const ctxRevenue = document.getElementById('monthlyRevenueChart');
  if (ctxRevenue && revenueData && revenueData.labels && revenueData.labels.length > 0) {
    new Chart(ctxRevenue, {
      type: 'bar',
      data: revenueData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(context) {
                return ' Revenue: ₹' + Number(context.raw).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN');
              }
            }
          }
        }
      }
    });
  } else if (ctxRevenue) {
    ctxRevenue.parentElement.innerHTML = '<div class="text-center py-5 text-muted small"><i class="bi bi-bar-chart fs-2 d-block mb-2"></i>No revenue records available for charting.</div>';
  }

  // 2. Chart 2: Room Category Distribution (Doughnut Chart)
  const ctxCategory = document.getElementById('roomCategoryChart');
  if (ctxCategory && categoryData && categoryData.labels && categoryData.labels.length > 0) {
    new Chart(ctxCategory, {
      type: 'doughnut',
      data: categoryData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom',
            labels: { boxWidth: 12, font: { size: 11 } }
          }
        }
      }
    });
  } else if (ctxCategory) {
    ctxCategory.parentElement.innerHTML = '<div class="text-center py-5 text-muted small"><i class="bi bi-pie-chart fs-2 d-block mb-2"></i>No room category data available.</div>';
  }

  // 3. Chart 3: Monthly Reservations Lifecycle (Stacked Bar Chart)
  const ctxReservations = document.getElementById('monthlyReservationsChart');
  if (ctxReservations && reservationsData && reservationsData.labels && reservationsData.labels.length > 0) {
    new Chart(ctxReservations, {
      type: 'bar',
      data: reservationsData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'top',
            labels: { boxWidth: 14 }
          }
        },
        scales: {
          x: { stacked: true },
          y: {
            stacked: true,
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });
  } else if (ctxReservations) {
    ctxReservations.parentElement.innerHTML = '<div class="text-center py-5 text-muted small"><i class="bi bi-graph-up fs-2 d-block mb-2"></i>No monthly booking data available for charting.</div>';
  }
});
</script>

<%- include('../partials/footer') %>

