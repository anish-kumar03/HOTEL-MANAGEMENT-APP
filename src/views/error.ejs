<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container my-5 flex-grow-1 d-flex align-items-center justify-content-center">
  <div class="card border-0 shadow-sm col-md-8 col-lg-6 p-4 text-center">
    <div class="card-body">
      <div class="mb-4">
        <% if (statusCode === 404) { %>
          <div class="display-1 text-warning fw-bold mb-2">404</div>
          <i class="bi bi-compass text-warning display-4"></i>
        <% } else { %>
          <div class="display-1 text-danger fw-bold mb-2"><%= statusCode %></div>
          <i class="bi bi-exclamation-octagon text-danger display-4"></i>
        <% } %>
      </div>

      <h3 class="fw-bold mb-3"><%= message %></h3>
      <p class="text-muted mb-4">
        <% if (statusCode === 404) { %>
          The page or endpoint you requested at <code class="text-dark bg-light px-2 py-1 rounded"><%= path %></code> could not be found.
        <% } else { %>
          An unexpected error occurred while processing your request. Please try again or contact the administrator.
        <% } %>
      </p>

      <% if (stack) { %>
        <div class="text-start mb-4">
          <button class="btn btn-sm btn-outline-secondary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#stackTrace" aria-expanded="false" aria-controls="stackTrace">
            <i class="bi bi-code-slash me-1"></i>View Debugging Stack Trace
          </button>
          <div class="collapse" id="stackTrace">
            <pre class="bg-dark text-light p-3 rounded small overflow-auto" style="max-height: 250px;"><code><%= stack %></code></pre>
          </div>
        </div>
      <% } %>

      <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-primary px-4 py-2">
          <i class="bi bi-house-door me-2"></i>Return to Home
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2">
          <i class="bi bi-arrow-left me-2"></i>Go Back
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

