<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/alerts') %>

  <!-- Header & Back Navigation -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Payment History Ledger</h2>
      <p class="text-muted mb-0">Audit log of all financial settlements, transaction references, and payment instruments.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/payments/new" class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-circle me-1"></i>Record Payment
      </a>
      <a href="/payments" class="btn btn-outline-secondary px-3 py-2">
        <i class="bi bi-arrow-left me-1"></i>Back to Payments
      </a>
    </div>
  </div>

  <% if (reservation) { %>
    <!-- Filtered by Specific Reservation Banner -->
    <div class="card bg-primary-subtle border-primary-subtle mb-4">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <span class="badge bg-primary me-2">Filtered By Booking</span>
          <strong><%= reservation.booking_code %></strong> &bull; <%= reservation.customer_name %> (Room <%= reservation.room_number %>)
        </div>
        <a href="/payments/history" class="btn btn-sm btn-outline-primary">Show All Transactions</a>
      </div>
    </div>
  <% } %>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/payments/history" method="GET" class="row g-2 align-items-center">
        <% if (reservationId) { %>
          <input type="hidden" name="reservation_id" value="<%= reservationId %>">
        <% } %>
        <div class="col-md-5">
          <select name="method" class="form-select bg-light">
            <option value="all">All Payment Methods</option>
            <% methods.forEach(m => { %>
              <option value="<%= m %>" <%= typeof filters !== 'undefined' && filters.method === m ? 'selected' : '' %>>
                <%= m %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-5">
          <select name="status" class="form-select bg-light">
            <option value="all">All Statuses</option>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= typeof filters !== 'undefined' && filters.status === s ? 'selected' : '' %>>
                <%= s %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-dark w-100">Apply Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- History Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-semibold">
        Settlement Logs <span class="badge bg-secondary-subtle text-secondary ms-2"><%= payments.length %> record(s)</span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (payments.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>
          No transaction history records found matching criteria.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-4">Receipt Ref</th>
                <th scope="col">Booking / Guest</th>
                <th scope="col">Amount</th>
                <th scope="col">Method</th>
                <th scope="col">Status</th>
                <th scope="col">Transaction ID</th>
                <th scope="col">Timestamp</th>
                <th scope="col" class="text-end pe-4">Receipt</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(p => { %>
                <tr>
                  <td class="ps-4 fw-bold font-monospace">
                    <%= p.payment_reference %>
                  </td>
                  <td>
                    <a href="/reservations/<%= p.reservation_id %>/invoice" class="text-decoration-none">
                      <%= p.booking_code %>
                    </a>
                    <div class="text-muted small"><%= p.customer_name %></div>
                  </td>
                  <td>
                    <span class="fw-bold fs-6">₹<%= Number(p.amount).toFixed(2) %></span>
                  </td>
                  <td>
                    <% if (p.payment_method === 'CASH') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">CASH</span>
                    <% } else if (p.payment_method === 'UPI') { %>
                      <span class="badge bg-info-subtle text-info border border-info-subtle">UPI</span>
                    <% } else { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">CARD</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= p.payment_status === 'SUCCESS' ? 'bg-success' : 'bg-warning text-dark' %>">
                      <%= p.payment_status %>
                    </span>
                  </td>
                  <td>
                    <span class="text-muted small font-monospace"><%= p.transaction_id || 'N/A' %></span>
                  </td>
                  <td>
                    <span class="text-muted small"><%= p.payment_date %></span>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/payments/<%= p.id %>/receipt" class="btn btn-sm btn-outline-dark" title="Print Receipt">
                      <i class="bi bi-printer me-1"></i>View
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
