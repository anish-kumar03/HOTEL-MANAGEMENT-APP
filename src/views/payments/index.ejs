<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/alerts') %>

  <!-- Header & Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-credit-card-fill text-primary me-2"></i>Payment Management</h2>
      <p class="text-muted mb-0">Record settlements, track partial payments, reconcile invoices, and print receipts.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/payments/history" class="btn btn-outline-dark px-3 py-2">
        <i class="bi bi-clock-history me-1"></i>Payment History
      </a>
      <a href="/payments/new" class="btn btn-primary px-3 py-2 shadow-sm">
        <i class="bi bi-cash-stack me-2"></i>Record Payment
      </a>
    </div>
  </div>

  <!-- Financial KPI Metrics Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small fw-semibold text-uppercase">Total Billed Revenue</div>
          <h3 class="fw-bold text-dark my-2">₹<%= Number(metrics.totalBilled).toFixed(2) %></h3>
          <span class="badge bg-light text-secondary border">Room + Services</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small fw-semibold text-uppercase text-success">Total Collected</div>
          <h3 class="fw-bold text-success my-2">₹<%= Number(metrics.totalCollected).toFixed(2) %></h3>
          <span class="badge bg-success-subtle text-success border border-success-subtle">
            <i class="bi bi-check-circle me-1"></i>Settled In Flow
          </span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small fw-semibold text-uppercase text-danger">Outstanding Balance</div>
          <h3 class="fw-bold text-danger my-2">₹<%= Number(metrics.totalOutstanding).toFixed(2) %></h3>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
            <i class="bi bi-exclamation-circle me-1"></i>Receivable
          </span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small fw-semibold text-uppercase">Transactions</div>
          <h3 class="fw-bold text-primary my-2"><%= metrics.totalTransactions %></h3>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
            <%= metrics.successfulTransactions %> Successful
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/payments" method="GET" class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input 
              type="text" 
              name="search" 
              class="form-control border-start-0 bg-light" 
              placeholder="Search receipt ref, booking code, customer, or transaction ID..." 
              value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
            >
          </div>
        </div>

        <!-- Filter Method -->
        <div class="col-md-3">
          <select name="method" class="form-select bg-light">
            <option value="all">All Payment Methods</option>
            <% methods.forEach(m => { %>
              <option value="<%= m %>" <%= typeof filters !== 'undefined' && filters.method === m ? 'selected' : '' %>>
                <%= m %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Filter Status -->
        <div class="col-md-2">
          <select name="status" class="form-select bg-light">
            <option value="all">All Statuses</option>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= typeof filters !== 'undefined' && filters.status === s ? 'selected' : '' %>>
                <%= s %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Submit & Reset -->
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-dark w-100">Filter</button>
          <% if (typeof filters !== 'undefined' && (filters.search || (filters.method && filters.method !== 'all') || (filters.status && filters.status !== 'all'))) { %>
            <a href="/payments" class="btn btn-outline-secondary" title="Reset">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Transactions Ledger Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0 fw-semibold">
        Payment Transactions 
        <span class="badge bg-secondary-subtle text-secondary ms-2"><%= payments.length %> record(s)</span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (payments.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-credit-card-2-front display-4 text-muted mb-3 d-block"></i>
          <h5 class="fw-semibold text-secondary">No payment transactions found</h5>
          <p class="text-muted small">Record a new payment to begin financial ledger tracking.</p>
          <a href="/payments/new" class="btn btn-sm btn-primary mt-2">
            <i class="bi bi-plus-circle me-1"></i>Record New Payment
          </a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-4">Receipt Ref</th>
                <th scope="col">Booking / Guest</th>
                <th scope="col">Room</th>
                <th scope="col">Amount</th>
                <th scope="col">Method</th>
                <th scope="col">Status</th>
                <th scope="col">Timestamp</th>
                <th scope="col" class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% payments.forEach(p => { %>
                <tr>
                  <td class="ps-4">
                    <a href="/payments/<%= p.id %>/receipt" class="fw-bold font-monospace text-decoration-none text-dark">
                      <%= p.payment_reference %>
                    </a>
                  </td>
                  <td>
                    <a href="/reservations/<%= p.reservation_id %>/invoice" class="fw-semibold text-decoration-none text-primary">
                      <%= p.booking_code %>
                    </a>
                    <div class="text-muted small"><%= p.customer_name %></div>
                  </td>
                  <td>
                    <span class="badge bg-light text-secondary border">Room <%= p.room_number %></span>
                  </td>
                  <td>
                    <span class="fw-bold fs-6 text-dark">₹<%= Number(p.amount).toFixed(2) %></span>
                  </td>
                  <td>
                    <% if (p.payment_method === 'CASH') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-cash me-1"></i>CASH
                      </span>
                    <% } else if (p.payment_method === 'UPI') { %>
                      <span class="badge bg-info-subtle text-info border border-info-subtle">
                        <i class="bi bi-qr-code me-1"></i>UPI
                      </span>
                    <% } else { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        <i class="bi bi-credit-card me-1"></i>CARD
                      </span>
                    <% } %>
                  </td>
                  <td>
                    <% if (p.payment_status === 'SUCCESS') { %>
                      <span class="badge bg-success">SUCCESS</span>
                    <% } else if (p.payment_status === 'PENDING') { %>
                      <span class="badge bg-warning text-dark">PENDING</span>
                    <% } else { %>
                      <span class="badge bg-danger">FAILED</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="text-muted small"><%= p.payment_date %></span>
                  </td>
                  <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                      <a href="/payments/<%= p.id %>/receipt" class="btn btn-outline-dark" title="Print Receipt">
                        <i class="bi bi-printer me-1"></i>Receipt
                      </a>
                      <a href="/reservations/<%= p.reservation_id %>/invoice" class="btn btn-outline-primary" title="View Full Invoice">
                        <i class="bi bi-file-earmark-text"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
