<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <!-- Breadcrumb & Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
        <li class="breadcrumb-item"><a href="/reports">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Room Availability Report</li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
        <i class="bi bi-printer me-1"></i>Print Report
      </button>
      <a href="/reports" class="btn btn-outline-dark btn-sm px-3 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>All Reports
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-warning-subtle text-warning rounded-3">
          <i class="bi bi-calendar-check fs-2"></i>
        </div>
        <div>
          <h3 class="fw-bold text-dark mb-0">Room Availability & Occupancy Audit</h3>
          <p class="text-muted small mb-0">
            Physical room inventory audit for target date <strong><%= targetDate %></strong>. Real-time conflict-free availability.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-3">
      <form action="/reports/room-availability" method="GET" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Target Inspection Date</label>
          <input type="date" name="targetDate" class="form-control form-control-sm" value="<%= filters.targetDate %>" required>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Room Category</label>
          <select name="category" class="form-select form-select-sm">
            <option value="all">All Room Categories</option>
            <% categories.forEach(c => { %>
              <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Availability Status</label>
          <select name="availabilityStatus" class="form-select form-select-sm">
            <option value="all" <%= filters.availabilityStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="AVAILABLE" <%= filters.availabilityStatus === 'AVAILABLE' ? 'selected' : '' %>>AVAILABLE (Ready to Book)</option>
            <option value="OCCUPIED" <%= filters.availabilityStatus === 'OCCUPIED' ? 'selected' : '' %>>OCCUPIED (Guest In House)</option>
            <option value="RESERVED" <%= filters.availabilityStatus === 'RESERVED' ? 'selected' : '' %>>RESERVED (Confirmed Booking)</option>
            <option value="MAINTENANCE" <%= filters.availabilityStatus === 'MAINTENANCE' ? 'selected' : '' %>>MAINTENANCE (Out of Order)</option>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
          <a href="/reports/room-availability" class="btn btn-light border btn-sm" title="Reset Today"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Evaluated Rooms</div>
          <h4 class="fw-bold text-dark my-1"><%= summary.totalRooms %></h4>
          <span class="badge bg-light text-secondary border">Total Units</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-success">Available Today</div>
          <h4 class="fw-bold text-success my-1"><%= summary.availableRooms %></h4>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Ready to Book</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-danger">Occupied</div>
          <h4 class="fw-bold text-danger my-1"><%= summary.occupiedRooms %></h4>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">In-House Stays</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-warning">Reserved</div>
          <h4 class="fw-bold text-dark my-1"><%= summary.reservedRooms %></h4>
          <span class="badge bg-warning-subtle text-dark border">Confirmed Stays</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-secondary">Maintenance</div>
          <h4 class="fw-bold text-secondary my-1"><%= summary.maintenanceRooms %></h4>
          <span class="badge bg-secondary-subtle text-secondary border">Out of Order</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-primary">Occupancy Rate</div>
          <h4 class="fw-bold text-primary my-1"><%= summary.occupancyRate %>%</h4>
          <div class="progress mt-1" style="height: 5px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: <%= summary.occupancyRate %>%;"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold">Room Availability Ledger for <%= targetDate %> (<%= rooms.length %> rooms)</h5>
    </div>
    <div class="card-body p-0">
      <% if (rooms.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-door-closed fs-1 d-block mb-2"></i>
          No room records match the selected category or status criteria.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Room Number</th>
                <th>Category</th>
                <th>Capacity</th>
                <th>Price / Night</th>
                <th>Operational Status</th>
                <th>Status on <%= targetDate %></th>
                <th>Active Guest / Booking</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody>
              <% rooms.forEach(r => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <i class="bi bi-door-open-fill text-muted me-1"></i>Room <%= r.room_number %>
                  </td>
                  <td><span class="badge bg-light text-dark border"><%= r.category %></span></td>
                  <td><%= r.capacity %> Person(s)</td>
                  <td class="fw-semibold">₹<%= Number(r.price_per_night).toFixed(2) %></td>
                  <td>
                    <span class="badge <%= r.operational_status === 'ACTIVE' ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary' %>">
                      <%= r.operational_status %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= r.badgeClass %> px-2 py-1">
                      <%= r.currentAvailability %>
                    </span>
                  </td>
                  <td>
                    <% if (r.guest_name) { %>
                      <div class="fw-semibold text-dark"><%= r.guest_name %></div>
                      <small class="text-muted font-monospace"><%= r.booking_code %> (<%= r.check_in_date %> &rarr; <%= r.check_out_date %>)</small>
                    <% } else { %>
                      <span class="text-muted small">No active booking for this date</span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <% if (r.currentAvailability === 'AVAILABLE') { %>
                      <a href="/reservations/new?room_id=<%= r.room_id %>&checkInDate=<%= targetDate %>" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-calendar-plus me-1"></i>Book
                      </a>
                    <% } else if (r.reservation_id) { %>
                      <a href="/reservations/<%= r.reservation_id %>" class="btn btn-outline-dark btn-sm">View Booking</a>
                    <% } else { %>
                      <a href="/rooms/<%= r.room_id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
