<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <!-- Breadcrumb & Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
        <li class="breadcrumb-item"><a href="/reports">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cancelled Reservation Report</li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
        <i class="bi bi-printer me-1"></i>Print Report
      </button>
      <a href="/reports" class="btn btn-outline-dark btn-sm px-3 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>All Reports
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-danger-subtle text-danger rounded-3">
          <i class="bi bi-x-circle fs-2"></i>
        </div>
        <div>
          <h3 class="fw-bold text-dark mb-0">Cancelled Reservation & Revenue Loss Audit</h3>
          <p class="text-muted small mb-0">Analysis of cancelled bookings, lost tariff revenues, customer attrition, and recorded cancellation reasons.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-3">
      <form action="/reports/cancelled-reservations" method="GET" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Search Booking / Guest</label>
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Booking code, guest name, email..." value="<%= filters.search %>">
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Check-In From</label>
          <input type="date" name="startDate" class="form-control form-control-sm" value="<%= filters.startDate %>">
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Check-In To</label>
          <input type="date" name="endDate" class="form-control form-control-sm" value="<%= filters.endDate %>">
        </div>
        <div class="col-sm-6 col-md-2">
          <label class="form-label small fw-semibold text-muted mb-1">Room Category</label>
          <select name="category" class="form-select form-select-sm">
            <option value="all">All Categories</option>
            <% categories.forEach(c => { %>
              <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-1 d-flex gap-1">
          <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i></button>
          <a href="/reports/cancelled-reservations" class="btn btn-light border btn-sm" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-danger">Cancelled Bookings</div>
          <h4 class="fw-bold text-danger my-1"><%= summary.total_cancelled %></h4>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Voided Stays</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-danger">Total Lost Revenue</div>
          <h4 class="fw-bold text-danger my-1">₹<%= Number(summary.total_lost_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-light text-secondary border">Unrealized Tariff</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Avg Lost Revenue / Stay</div>
          <h4 class="fw-bold text-dark my-1">₹<%= Number(summary.avg_lost_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-light text-secondary border">Per Cancellation</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Cancellation Rate</div>
          <h4 class="fw-bold text-dark my-1"><%= summary.cancellationRate %>%</h4>
          <span class="badge bg-light text-secondary border">Of All System Bookings</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold">Cancelled Reservation Audit Trail (<%= cancellations.length %>)</h5>
    </div>
    <div class="card-body p-0">
      <% if (cancellations.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-shield-check fs-1 d-block mb-2 text-success"></i>
          No cancelled reservations match the filter criteria.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Booking Code</th>
                <th>Guest Information</th>
                <th>Room Info</th>
                <th>Scheduled Stay</th>
                <th>Lost Revenue</th>
                <th>Cancellation Reason</th>
                <th>Cancelled At</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody>
              <% cancellations.forEach(c => { %>
                <tr>
                  <td class="ps-3 font-monospace fw-semibold text-danger"><%= c.booking_code %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= c.customer_name %></div>
                    <small class="text-muted"><%= c.customer_phone %></small>
                  </td>
                  <td>Room <%= c.room_number %> <span class="badge bg-light text-dark border"><%= c.room_category %></span></td>
                  <td class="small">
                    <%= c.check_in_date %> &rarr; <%= c.check_out_date %> (<%= c.nights %> nts)
                  </td>
                  <td class="fw-bold text-danger">₹<%= Number(c.lost_revenue).toFixed(2) %></td>
                  <td class="small text-secondary" style="max-width: 250px;">
                    <i class="bi bi-chat-left-quote me-1 text-muted"></i><%= c.cancellation_reason %>
                  </td>
                  <td class="small text-muted"><%= c.cancelled_at %></td>
                  <td class="text-end pe-3">
                    <a href="/reservations/<%= c.id %>" class="btn btn-outline-dark btn-sm">Audit Log</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
