<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <!-- Breadcrumb & Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
        <li class="breadcrumb-item"><a href="/reports">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Monthly Revenue Report</li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
        <i class="bi bi-printer me-1"></i>Print Report
      </button>
      <a href="/reports" class="btn btn-outline-dark btn-sm px-3 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>All Reports
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-success-subtle text-success rounded-3">
          <i class="bi bi-graph-up-arrow fs-2"></i>
        </div>
        <div>
          <h3 class="fw-bold text-dark mb-0">Monthly Revenue & Settlement Breakdown</h3>
          <p class="text-muted small mb-0">Financial audit of collections across Cash, UPI, and Card instruments for Year <%= filters.year %>.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-3">
      <form action="/reports/monthly-revenue" method="GET" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Fiscal / Calendar Year</label>
          <select name="year" class="form-select form-select-sm">
            <% for (let y = currentYear + 1; y >= currentYear - 4; y--) { %>
              <option value="<%= y %>" <%= filters.year === y ? 'selected' : '' %>><%= y %></option>
            <% } %>
          </select>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Payment Method</label>
          <select name="method" class="form-select form-select-sm">
            <option value="all">All Instruments (CASH, UPI, CARD)</option>
            <% methods.forEach(m => { %>
              <option value="<%= m %>" <%= filters.method === m ? 'selected' : '' %>><%= m %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Settlement Status</label>
          <select name="paymentStatus" class="form-select form-select-sm">
            <option value="all" <%= filters.paymentStatus === 'all' ? 'selected' : '' %>>All Statuses</option>
            <% paymentStatuses.forEach(s => { %>
              <option value="<%= s %>" <%= filters.paymentStatus === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
          <a href="/reports/monthly-revenue" class="btn btn-light border btn-sm" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-success">Total Collections</div>
          <h4 class="fw-bold text-success my-1">₹<%= Number(summary.grandTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Year <%= filters.year %> Intakes</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Cash Collections</div>
          <h4 class="fw-bold text-dark my-1">₹<%= Number(summary.totalCash).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-light text-secondary border">Front Desk Cash</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-primary">UPI Payments</div>
          <h4 class="fw-bold text-primary my-1">₹<%= Number(summary.totalUpi).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Digital UPI (GPay/PhonePe)</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-info">Card Payments</div>
          <h4 class="fw-bold text-info my-1">₹<%= Number(summary.totalCard).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-info-subtle text-info border border-info-subtle">POS / Credit Card</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Transactions Settled</div>
          <h4 class="fw-bold text-dark my-1"><%= summary.totalTransactions %></h4>
          <span class="badge bg-light text-secondary border">Verified Payment Records</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold">Monthly Revenue Ledger for <%= filters.year %></h5>
    </div>
    <div class="card-body p-0">
      <% if (monthlyBreakdown.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-wallet2 fs-1 d-block mb-2"></i>
          No revenue transactions found for year <%= filters.year %> matching the criteria.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Month</th>
                <th>Txn Count</th>
                <th>Cash (₹)</th>
                <th>UPI (₹)</th>
                <th>Card (₹)</th>
                <th>Gross Collections</th>
                <th class="pe-3">Avg Transaction Size</th>
              </tr>
            </thead>
            <tbody>
              <% monthlyBreakdown.forEach(m => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark"><i class="bi bi-calendar3 me-2 text-primary"></i><%= m.month_name %></td>
                  <td><span class="badge bg-light text-dark border"><%= m.transaction_count %></span></td>
                  <td>₹<%= Number(m.cash_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td>₹<%= Number(m.upi_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td>₹<%= Number(m.card_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="fw-bold text-success fs-6">
                    ₹<%= Number(m.total_collected).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                  <td class="pe-3 text-muted">
                    ₹<%= Number(m.avg_transaction_value).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
