<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <!-- Breadcrumb & Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
        <li class="breadcrumb-item"><a href="/reports">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Daily Reservation Report</li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
        <i class="bi bi-printer me-1"></i>Print Report
      </button>
      <a href="/reports" class="btn btn-outline-dark btn-sm px-3 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>All Reports
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-info-subtle text-info rounded-3">
          <i class="bi bi-calendar2-day fs-2"></i>
        </div>
        <div>
          <h3 class="fw-bold text-dark mb-0">Daily Reservation Report</h3>
          <p class="text-muted small mb-0">Itemized reservation ledger with stay duration, guest counts, and booked revenues.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-3">
      <form action="/reports/daily-reservations" method="GET" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Check-In From</label>
          <input type="date" name="startDate" class="form-control form-control-sm" value="<%= filters.startDate %>">
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Check-In To</label>
          <input type="date" name="endDate" class="form-control form-control-sm" value="<%= filters.endDate %>">
        </div>
        <div class="col-sm-6 col-md-2">
          <label class="form-label small fw-semibold text-muted mb-1">Booking Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="all">All Statuses</option>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-sm-6 col-md-2">
          <label class="form-label small fw-semibold text-muted mb-1">Room Category</label>
          <select name="category" class="form-select form-select-sm">
            <option value="all">All Categories</option>
            <% categories.forEach(c => { %>
              <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
          <a href="/reports/daily-reservations" class="btn btn-light border btn-sm" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Bookings</div>
          <h4 class="fw-bold text-dark my-1"><%= summary.total_bookings %></h4>
          <span class="badge bg-light text-secondary border">Matching Criteria</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Total Guests</div>
          <h4 class="fw-bold text-primary my-1"><%= summary.total_guests %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Capacity Booked</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-success">Total Booked Revenue</div>
          <h4 class="fw-bold text-success my-1">₹<%= Number(summary.total_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Tariff Sum</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Avg Booking Value</div>
          <h4 class="fw-bold text-dark my-1">₹<%= Number(summary.avg_booking_value).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-light text-secondary border">Per Reservation</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Checked-In / Cancelled</div>
          <h4 class="fw-bold my-1">
            <span class="text-primary"><%= summary.checked_in_count %></span> / 
            <span class="text-danger"><%= summary.cancelled_count %></span>
          </h4>
          <span class="badge bg-light text-secondary border">Active Stay vs Cancel</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Data Table -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0 fw-bold">Reservation Records (<%= records.length %>)</h5>
    </div>
    <div class="card-body p-0">
      <% if (records.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>
          No reservation records match the selected filter criteria.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Booking Code</th>
                <th>Guest Details</th>
                <th>Room Info</th>
                <th>Stay Dates</th>
                <th>Nights</th>
                <th>Rate / Night</th>
                <th>Total Tariff</th>
                <th>Status</th>
                <th class="text-end pe-3">Action</th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(r => { %>
                <tr>
                  <td class="ps-3 font-monospace fw-semibold"><%= r.booking_code %></td>
                  <td>
                    <div class="fw-semibold"><%= r.customer_name %></div>
                    <small class="text-muted"><i class="bi bi-telephone me-1"></i><%= r.customer_phone %></small>
                  </td>
                  <td>Room <%= r.room_number %> <span class="badge bg-light text-dark border"><%= r.room_category %></span></td>
                  <td>
                    <div class="small fw-semibold"><%= r.check_in_date %> &rarr; <%= r.check_out_date %></div>
                  </td>
                  <td><%= r.nights %> nt(s)</td>
                  <td>₹<%= Number(r.nightly_rate).toFixed(2) %></td>
                  <td class="fw-bold text-success">₹<%= Number(r.total_amount).toFixed(2) %></td>
                  <td>
                    <% if (r.status === 'confirmed') { %>
                      <span class="badge bg-success">Confirmed</span>
                    <% } else if (r.status === 'checked_in') { %>
                      <span class="badge bg-primary">Checked In</span>
                    <% } else if (r.status === 'checked_out') { %>
                      <span class="badge bg-secondary">Checked Out</span>
                    <% } else if (r.status === 'cancelled') { %>
                      <span class="badge bg-danger">Cancelled</span>
                    <% } else { %>
                      <span class="badge bg-warning text-dark"><%= r.status %></span>
                    <% } %>
                  </td>
                  <td class="text-end pe-3">
                    <a href="/reservations/<%= r.id %>" class="btn btn-outline-dark btn-sm">Details</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

