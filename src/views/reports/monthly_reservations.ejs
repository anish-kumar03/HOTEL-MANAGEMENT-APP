<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 my-4">
  <!-- Breadcrumb & Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-door"></i> Home</a></li>
        <li class="breadcrumb-item"><a href="/reports">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Monthly Reservation Report</li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary btn-sm px-3 shadow-sm">
        <i class="bi bi-printer me-1"></i>Print Report
      </button>
      <a href="/reports" class="btn btn-outline-dark btn-sm px-3 shadow-sm">
        <i class="bi bi-arrow-left me-1"></i>All Reports
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-4">
      <div class="d-flex align-items-center gap-3">
        <div class="p-3 bg-primary-subtle text-primary rounded-3">
          <i class="bi bi-calendar2-month fs-2"></i>
        </div>
        <div>
          <h3 class="fw-bold text-dark mb-0">Monthly Reservation Report</h3>
          <p class="text-muted small mb-0">Aggregated monthly booking metrics, stay length analysis, and cancellation tracking.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-body p-3">
      <form action="/reports/monthly-reservations" method="GET" class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Fiscal / Calendar Year</label>
          <select name="year" class="form-select form-select-sm">
            <% for (let y = currentYear + 1; y >= currentYear - 4; y--) { %>
              <option value="<%= y %>" <%= filters.year === y ? 'selected' : '' %>><%= y %></option>
            <% } %>
          </select>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Reservation Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="all">All Statuses</option>
            <% statuses.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-sm-6 col-md-3">
          <label class="form-label small fw-semibold text-muted mb-1">Room Category</label>
          <select name="category" class="form-select form-select-sm">
            <option value="all">All Categories</option>
            <% categories.forEach(c => { %>
              <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
          <a href="/reports/monthly-reservations" class="btn btn-light border btn-sm" title="Clear Filters"><i class="bi bi-x-circle"></i></a>
        </div>
      </form>
    </div>
  </div>

  <!-- Grand Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Year Bookings</div>
          <h4 class="fw-bold text-dark my-1"><%= grandSummary.total_bookings %></h4>
          <span class="badge bg-light text-secondary border">Year <%= filters.year %></span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Total Nights</div>
          <h4 class="fw-bold text-primary my-1"><%= grandSummary.total_nights %></h4>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Room Nights</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-2">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold">Avg Stay (ALOS)</div>
          <h4 class="fw-bold text-dark my-1"><%= grandSummary.avg_stay_length %> <small class="fs-6 fw-normal text-muted">nts</small></h4>
          <span class="badge bg-light text-secondary border">Per Booking</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-success">Total Booked Value</div>
          <h4 class="fw-bold text-success my-1">₹<%= Number(grandSummary.total_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></h4>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Yearly Aggregate</span>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm bg-white h-100">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-semibold text-danger">Cancelled Stays</div>
          <h4 class="fw-bold text-danger my-1"><%= grandSummary.cancelled_count %></h4>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
            <%= grandSummary.total_bookings > 0 ? ((grandSummary.cancelled_count / grandSummary.total_bookings) * 100).toFixed(1) : 0 %>% Rate
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Monthly Aggregations Table -->
  <div class="card border-0 shadow-sm bg-white mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold">Monthly Performance Matrix (<%= filters.year %>)</h5>
    </div>
    <div class="card-body p-0">
      <% if (monthlyData.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2"></i>
          No reservation records found for year <%= filters.year %> with the selected filters.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Month</th>
                <th>Total Bookings</th>
                <th>Total Nights</th>
                <th>Avg Stay (ALOS)</th>
                <th>Booked Revenue</th>
                <th>Avg Booking Value</th>
                <th>Cancelled</th>
                <th class="pe-3">Cancellation Rate</th>
              </tr>
            </thead>
            <tbody>
              <% monthlyData.forEach(m => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark"><i class="bi bi-calendar3 me-2 text-primary"></i><%= m.month_name %></td>
                  <td><span class="badge bg-light text-dark border fs-6"><%= m.total_bookings %></span></td>
                  <td><%= m.total_nights %> nts</td>
                  <td><%= m.avg_stay_length %> nights</td>
                  <td class="fw-bold text-success">₹<%= Number(m.total_revenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td>₹<%= Number(m.avg_booking_value).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td><span class="badge bg-danger-subtle text-danger"><%= m.cancelled_count %></span></td>
                  <td class="pe-3">
                    <div class="d-flex align-items-center gap-2">
                      <div class="progress flex-grow-1" style="height: 6px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: <%= Math.min(100, m.cancellation_rate) %>%;"></div>
                      </div>
                      <span class="small fw-semibold"><%= m.cancellation_rate %>%</span>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
