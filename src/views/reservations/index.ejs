<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container my-5">
  <%- include('../partials/alerts') %>

  <!-- Header & Actions -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-journal-bookmark-fill text-primary me-2"></i>Reservation Management</h2>
      <p class="text-muted mb-0">Create, track, process guest check-ins, check-outs, and manage room bookings.</p>
    </div>
    <div>
      <a href="/reservations/new" class="btn btn-primary px-3 py-2 shadow-sm">
        <i class="bi bi-calendar-plus me-2"></i>New Booking
      </a>
    </div>
  </div>

  <!-- Search & Status Filters -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <div class="row g-3 align-items-center">
        <!-- Status Filter Pills -->
        <div class="col-lg-7">
          <div class="d-flex flex-wrap gap-1">
            <% const currentStatus = typeof filters !== 'undefined' && filters.status ? filters.status : 'all'; %>
            <a href="/reservations?status=all<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'all' ? 'btn-dark' : 'btn-outline-secondary' %>">
              All
            </a>
            <a href="/reservations?status=confirmed<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'confirmed' ? 'btn-primary' : 'btn-outline-primary' %>">
              Confirmed
            </a>
            <a href="/reservations?status=checked_in<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'checked_in' ? 'btn-success' : 'btn-outline-success' %>">
              Checked In
            </a>
            <a href="/reservations?status=checked_out<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'checked_out' ? 'btn-secondary' : 'btn-outline-secondary' %>">
              Checked Out
            </a>
            <a href="/reservations?status=pending<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'pending' ? 'btn-warning' : 'btn-outline-warning' %>">
              Pending
            </a>
            <a href="/reservations?status=cancelled<%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>" 
               class="btn btn-sm <%= currentStatus === 'cancelled' ? 'btn-danger' : 'btn-outline-danger' %>">
              Cancelled
            </a>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="col-lg-5">
          <form action="/reservations" method="GET" class="d-flex gap-2">
            <% if (currentStatus !== 'all') { %>
              <input type="hidden" name="status" value="<%= currentStatus %>">
            <% } %>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">
                <i class="bi bi-search text-muted"></i>
              </span>
              <input 
                type="text" 
                name="search" 
                class="form-control border-start-0 bg-light" 
                placeholder="Search booking code, guest, or room..." 
                value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>"
              >
            </div>
            <button type="submit" class="btn btn-dark">Search</button>
            <% if (typeof filters !== 'undefined' && (filters.search || filters.status !== 'all')) { %>
              <a href="/reservations" class="btn btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
              </a>
            <% } %>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Reservations Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="card-title mb-0 fw-semibold">
        Bookings Roster
        <span class="badge bg-secondary-subtle text-secondary ms-2"><%= reservations.length %> record(s)</span>
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (reservations.length === 0) { %>
        <div class="text-center py-5">
          <i class="bi bi-calendar-x display-4 text-muted mb-3 d-block"></i>
          <h5 class="fw-semibold text-secondary">No reservations found</h5>
          <p class="text-muted small">
            <% if (typeof filters !== 'undefined' && (filters.search || filters.status !== 'all')) { %>
              No bookings matched your active search and filter criteria.
            <% } else { %>
              There are currently no reservations in the system.
            <% } %>
          </p>
          <a href="/reservations/new" class="btn btn-sm btn-primary mt-2">
            <i class="bi bi-plus-circle me-1"></i>Create First Reservation
          </a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-4">Booking ID</th>
                <th scope="col">Guest Details</th>
                <th scope="col">Room</th>
                <th scope="col">Stay Dates</th>
                <th scope="col">Nights</th>
                <th scope="col">Total Amount</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% reservations.forEach(res => { %>
                <tr>
                  <td class="ps-4">
                    <a href="/reservations/<%= res.id %>" class="fw-bold text-dark text-decoration-none font-monospace">
                      <%= res.booking_code %>
                    </a>
                    <div class="text-muted small"><%= res.booking_date %></div>
                  </td>
                  <td>
                    <a href="/customers/<%= res.customer_id %>" class="fw-semibold text-decoration-none text-dark">
                      <%= res.customer_name %>
                    </a>
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i><%= res.customer_phone %></div>
                  </td>
                  <td>
                    <span class="fw-bold">Room <%= res.room_number %></span>
                    <div class="text-muted small"><%= res.room_category %> (<%= res.guests_count %> guests)</div>
                  </td>
                  <td>
                    <div class="small">
                      <span class="text-success"><i class="bi bi-box-arrow-in-right me-1"></i><%= res.check_in_date %></span>
                    </div>
                    <div class="small">
                      <span class="text-danger"><i class="bi bi-box-arrow-right me-1"></i><%= res.check_out_date %></span>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-light text-secondary border">
                      <%= res.nights %> <%= res.nights === 1 ? 'Night' : 'Nights' %>
                    </span>
                  </td>
                  <td>
                    <span class="fw-bold text-dark fs-6">₹<%= Number(res.total_amount).toFixed(2) %></span>
                    <div class="text-muted small">@ ₹<%= Number(res.nightly_rate).toFixed(2) %>/nt</div>
                  </td>
                  <td>
                    <% if (res.status === 'confirmed') { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1">
                        <i class="bi bi-check-circle me-1"></i>Confirmed
                      </span>
                    <% } else if (res.status === 'checked_in') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                        <i class="bi bi-door-open me-1"></i>Checked In
                      </span>
                    <% } else if (res.status === 'checked_out') { %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1">
                        <i class="bi bi-door-closed me-1"></i>Checked Out
                      </span>
                    <% } else if (res.status === 'pending') { %>
                      <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1">
                        <i class="bi bi-clock-history me-1"></i>Pending
                      </span>
                    <% } else if (res.status === 'cancelled') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1">
                        <i class="bi bi-x-circle me-1"></i>Cancelled
                      </span>
                    <% } else { %>
                      <span class="badge bg-light text-secondary border"><%= res.status %></span>
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                      <a href="/reservations/<%= res.id %>" class="btn btn-outline-primary" title="View Full Folio">
                        <i class="bi bi-eye"></i>
                      </a>

                      <!-- Check-in trigger -->
                      <% if (res.status === 'confirmed' || res.status === 'pending') { %>
                        <form action="/reservations/<%= res.id %>/checkin" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-outline-success" title="Check-In Guest">
                            <i class="bi bi-box-arrow-in-right"></i>
                          </button>
                        </form>
                      <% } %>

                      <!-- Check-out trigger -->
                      <% if (res.status === 'checked_in') { %>
                        <form action="/reservations/<%= res.id %>/checkout" method="POST" class="d-inline">
                          <button type="submit" class="btn btn-outline-warning" title="Check-Out Guest">
                            <i class="bi bi-box-arrow-right"></i>
                          </button>
                        </form>
                      <% } %>

                      <!-- Cancel trigger -->
                      <% if (res.status !== 'cancelled' && res.status !== 'checked_out') { %>
                        <button 
                          type="button" 
                          class="btn btn-outline-danger" 
                          title="Cancel Reservation"
                          data-bs-toggle="modal" 
                          data-bs-target="#cancelModal<%= res.id %>"
                        >
                          <i class="bi bi-x-circle"></i>
                        </button>
                      <% } %>
                    </div>

                    <!-- Cancel Modal -->
                    <% if (res.status !== 'cancelled' && res.status !== 'checked_out') { %>
                      <div class="modal fade text-start" id="cancelModal<%= res.id %>" tabindex="-1" aria-labelledby="cancelModalLabel<%= res.id %>" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                          <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-danger text-white">
                              <h5 class="modal-title" id="cancelModalLabel<%= res.id %>">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Reservation
                              </h5>
                              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form action="/reservations/<%= res.id %>/cancel" method="POST">
                              <div class="modal-body p-4">
                                <p class="mb-2">Are you sure you want to cancel booking <strong><%= res.booking_code %></strong> for <strong><%= res.customer_name %></strong>?</p>
                                <p class="text-muted small">This action releases Room <%= res.room_number %> back into inventory for these dates.</p>
                                <div class="mb-3">
                                  <label for="reason<%= res.id %>" class="form-label small fw-semibold">Reason for Cancellation</label>
                                  <input type="text" class="form-control form-control-sm" id="reason<%= res.id %>" name="reason" placeholder="e.g. Guest travel plan rescheduled" required>
                                </div>
                              </div>
                              <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Booking</button>
                                <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                              </div>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
