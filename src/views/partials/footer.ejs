<!-- Logout Confirmation Modal -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom">
        <h5 class="modal-title fw-bold" id="logoutModalLabel">
          <i class="bi bi-box-arrow-left text-danger me-2"></i>Sign Out Confirmation
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 text-center">
        <div class="empty-state-icon mx-auto mb-3" style="width: 56px; height: 56px; background-color: #fee2e2; color: #ef4444;">
          <i class="bi bi-shield-lock fs-3"></i>
        </div>
        <h5 class="fw-bold text-dark">Ready to end your session?</h5>
        <p class="text-muted small mb-0">
          Ensure all pending guest checks and payment folios are saved before closing the administrative panel.
        </p>
      </div>
      <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger btn-sm px-3" onclick="window.location.href='/';">Sign Out</button>
      </div>
    </div>
  </div>
</div>

